# API base URL (leave empty to use /api prefix)
# For local dev with Vite proxy: defaults to /api
VITE_API_BASE=/api

# Sensitive/runtime config is loaded from /api/config.
# Set these on your server/platform environment, never in frontend env files:
# FIREBASE_API_KEY, FIREBASE_AUTH_DOMAIN, FIREBASE_PROJECT_ID,
# FIREBASE_STORAGE_BUCKET, FIREBASE_MESSAGING_SENDER_ID,
# FIREBASE_APP_ID, FIREBASE_MEASUREMENT_ID
